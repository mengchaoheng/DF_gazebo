<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
   <gui>
      <camera name="user_camera">
        <track_visual>
          <!-- Set fixed view perspective or not. -->
          <static>false</static>
          <use_model_frame>true</use_model_frame>
          <!-- Camera position offset relative to the target when <static> is set to true -->
          <xyz>-2 0 0.5</xyz>
          <!-- Optional: When static=false, you can also use <min_dist> and <max_dist> to control the follow distance -->
          <min_dist>0.5</min_dist>
          <max_dist>3.0</max_dist>
        </track_visual>
      </camera>
    </gui>
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://asphalt_plane</uri>
    </include>
    <plugin name='wind_plugin' filename='libgazebo_wind_plugin.so'>
      <frameId>base_link</frameId>
      <robotNamespace/>
      <windVelocityMean>5</windVelocityMean>
      <windVelocityMax>20.0</windVelocityMax>
      <windVelocityVariance>0.0</windVelocityVariance>
      <windDirectionMean>-1 0 0</windDirectionMean>
      <windDirectionVariance>0</windDirectionVariance>
      <windGustStart>100</windGustStart>
      <windGustDuration>70</windGustDuration>
      <windGustVelocityMean>5</windGustVelocityMean>
      <windGustVelocityMax>20.0</windGustVelocityMax>
      <windGustVelocityVariance>0</windGustVelocityVariance>
      <windGustDirectionMean>-1 0 0</windGustDirectionMean>
      <windGustDirectionVariance>0</windGustDirectionVariance>
      <windRampStart>0</windRampStart>
      <windChangeRampDuration>0</windChangeRampDuration>
      <windRampWindVectorComponents>-0 0 0</windRampWindVectorComponents>

      <windPubTopic>world_wind</windPubTopic>
    </plugin>
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
  </world>
</sdf>
