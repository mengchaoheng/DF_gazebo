    <plugin name="torque_disturbance" filename="libtorque_disturbance_plugin.so">
      <link_name>base_link</link_name>

      <start_time>30.0</start_time>
      <running_time>0.0</running_time>
      <repeat_count>1</repeat_count>
      <repeat_interval>8.0</repeat_interval>

      <!-- 力矩扰动，单位 N·m -->
      <bias_x>0.0</bias_x>
      <bias_y>0.0</bias_y>
      <bias_z>0.0</bias_z>
      <amplitude_x>0.1</amplitude_x>
      <amplitude_y>0.1</amplitude_y>
      <amplitude_z>0.01</amplitude_z>
      <frequency_x>0.2</frequency_x>
      <frequency_y>0.4</frequency_y>
      <frequency_z>0.2</frequency_z>

      <!-- 力扰动，单位 N，方向在 base_link 坐标系下 -->
      <force_bias_x>0.0</force_bias_x>
